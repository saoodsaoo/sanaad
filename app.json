{
  "expo": {
    "name": "سند",
    "slug": "sanad",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "myapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "sdkVersion": "54.0.0",
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "android": {
      "package": "com.saood.sanad"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "25e464e5-1495-4706-b3eb-bea843125949"
      }
    }
  }
}
